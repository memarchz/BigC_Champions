# คัดลอกไปใส่ใน Railway → Variables
# ห้าม commit ไฟล์นี้ขึ้น GitHub จริงๆ

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# วิธีได้ลิ้ง OneDrive:
# 1. เปิดไฟล์ใน OneDrive
# 2. คลิก Share → Copy link
# 3. เปลี่ยน URL จาก ...sharepoint.com/...?e=xxxx
#    เป็น          ...sharepoint.com/...?download=1
RESPOND_EXCEL_URL=https://bjcgrp-my.sharepoint.com/...?download=1
DATABASE_EXCEL_URL=https://bjcgrp-my.sharepoint.com/...?download=1
